{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Story Workbench",
  "version": "0.8.10",
  "identifier": "local.storyworkbench.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/story-server"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "linux": {
      "deb": {
        "depends": [
          "espeak-ng",
          "gstreamer1.0-plugins-good",
          "xdg-utils",
          "libdbus-1-3",
          "libc6 (>= 2.38)"
        ]
      }
    },
    "category": "Productivity",
    "shortDescription": "Creación guiada y revisión editorial",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "zlib"
      }
    }
  }
}
